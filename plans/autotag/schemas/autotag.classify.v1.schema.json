{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activewatcher.local/schemas/autotag.classify.v1.schema.json",
  "title": "Autotag Pass A Classify v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "items"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "autotag.classify.v1"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/passAItem"
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tokenSuggestions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apps",
        "domains",
        "titles",
        "urls",
        "title_regex"
      ],
      "properties": {
        "apps": {
          "$ref": "#/$defs/stringArray"
        },
        "domains": {
          "$ref": "#/$defs/stringArray"
        },
        "titles": {
          "$ref": "#/$defs/stringArray"
        },
        "urls": {
          "$ref": "#/$defs/stringArray"
        },
        "title_regex": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "passAItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "entity",
        "target_category_id",
        "confidence",
        "reasons",
        "risk_flags",
        "token_suggestions"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "app",
            "domain"
          ]
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "target_category_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risk_flags": {
          "$ref": "#/$defs/stringArray"
        },
        "token_suggestions": {
          "$ref": "#/$defs/tokenSuggestions"
        }
      }
    }
  }
}
